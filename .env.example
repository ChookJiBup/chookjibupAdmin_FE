# 백엔드 API 서버 주소 (next.config.ts의 rewrites에서 사용)
BACKEND_ORIGIN=http://localhost:8080

# 카카오맵 JavaScript SDK 키 (Kakao Developers > 축지법 관련 앱 > 플랫폼 키)
NEXT_PUBLIC_KAKAO_MAP_KEY=

# 바탕 지도 타일 주소(Leaflet). 비워 두면 상호명 라벨이 없는 CARTO Voyager 타일을 쓴다.
#   https://{s}.basemaps.cartocdn.com/rastertiles/voyager_nolabels/{z}/{x}/{y}{r}.png
# CARTO Basemaps는 개발·운영 모두 API 키가 필요하다. 아래 주소의 YOUR_KEY를 발급받은 키로 바꿔 설정한다.
# https://{s}.basemaps.cartocdn.com/rastertiles/voyager_nolabels/{z}/{x}/{y}{r}.png?key=YOUR_KEY
# .env.local과 배포 환경에 설정하고, 값 변경 후 개발 서버 재시작 또는 재빌드가 필요하다.
# {s}=서브도메인(a~d), {z}/{x}/{y}=타일 좌표, {r}=고해상도 화면용 @2x 접미사
NEXT_PUBLIC_MAP_TILE_URL=

# 지도 오른쪽 아래 출처 표시(HTML 허용). 타일 약관상 반드시 화면에 보여야 한다.
# 비워 두면 OpenStreetMap·CARTO 표기를 쓴다. 타일 서버를 바꾸면 그 서버가 요구하는 문구로 맞춘다.
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=
